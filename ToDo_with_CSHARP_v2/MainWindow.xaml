<Window x:Class="ToDo_with_CSHARP_v2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер Задач (WPF)" Height="600" Width="900"
        Background="#F5F6FA" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель управления -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBox x:Name="txtSearch" Width="250" Padding="8" FontSize="14" TextChanged="TxtSearch_TextChanged">
                <TextBox.Text>
                    <Binding Path="Text" UpdateSourceTrigger="PropertyChanged"/>
                </TextBox.Text>
            </TextBox>
            <TextBlock Text="Поиск..." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>

            <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                <Button Content="➕ Добавить" Width="100" Height="35" Background="#2ecc71" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnAdd_Click" Margin="0,0,10,0"/>
                <Button Content="🗑 Удалить" Width="100" Height="35" Background="#e74c3c" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnDelete_Click" Margin="0,0,10,0"/>
                <Button Content="🔄 Обновить" Width="100" Height="35" Background="#3498db" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="BtnRefresh_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Таблица задач -->
        <DataGrid x:Name="dgTasks" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                  SelectionMode="Single" HeadersVisibility="Column" RowHeight="40" ColumnHeaderHeight="40"
                  MouseDoubleClick="DgTasks_MouseDoubleClick">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2C3E50"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,5"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderBrush" Value="#ddd"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Style.Triggers>
                        <!-- Статус "Готово" -> Зеленый -->
                        <DataTrigger Binding="{Binding StatusName}" Value="Готово">
                            <Setter Property="Background" Value="#D5F5E3"/>
                            <Setter Property="Foreground" Value="#145A32"/>
                        </DataTrigger>
                        <!-- Просрочено -> Красный фон (Идея расширения) -->
                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                            <Setter Property="Background" Value="#FADBD8"/>
                            <Setter Property="Foreground" Value="#7B241C"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <!-- Приоритет (Кружочки) -->
                <DataGridTemplateColumn Header="Приоритет" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="15" Height="15" HorizontalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Priority}" Value="3">
                                                <Setter Property="Fill" Value="Red"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Priority}" Value="2">
                                                <Setter Property="Fill" Value="Orange"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Priority}" Value="1">
                                                <Setter Property="Fill" Value="Green"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Задача" Binding="{Binding Title}" Width="2*" FontWeight="Bold"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>

                <!-- Категория с цветом -->
                <DataGridTemplateColumn Header="Категория" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="10" Height="10" Margin="0,0,5,0" RadiusX="2" RadiusY="2">
                                    <Rectangle.Fill>
                                        <SolidColorBrush Color="{Binding CategoryColor, TargetNullValue=Gray}"/>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock Text="{Binding CategoryName}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="100"/>
                <DataGridTextColumn Header="Дедлайн" Binding="{Binding Deadline, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>