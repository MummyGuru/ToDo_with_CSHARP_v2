<Window x:Class="ToDo_with_CSHARP_v2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер Задач" Height="550" Width="900"
        Background="#F0F2F5" FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Панель управления -->
            <RowDefinition Height="*"/>
            <!-- Таблица -->
        </Grid.RowDefinitions>

        <!-- Верхняя панель: Поиск и Кнопки -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">

            <!-- Поиск -->
            <TextBox x:Name="txtSearch" Width="250" Padding="8" FontSize="14"
                     TextChanged="TxtSearch_TextChanged">
                <TextBox.Text>
                    <Binding Path="Text" UpdateSourceTrigger="PropertyChanged"/>
                </TextBox.Text>
            </TextBox>
            <TextBlock Text="Поиск..." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>

            <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                <Button x:Name="btnAdd" Content="➕ Добавить" Width="100" Height="35" 
                        Background="#2ecc71" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Click="BtnAdd_Click" Margin="0,0,10,0"/>

                <Button x:Name="btnDelete" Content="🗑 Удалить" Width="100" Height="35" 
                        Background="#e74c3c" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Click="BtnDelete_Click" Margin="0,0,10,0"/>

                <Button x:Name="btnRefresh" Content="🔄 Обновить" Width="100" Height="35" 
                        Background="#3498db" Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Click="BtnRefresh_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Таблица задач -->
        <DataGrid x:Name="dgTasks" Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeight="40"
                  ColumnHeaderHeight="40">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#34495e"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="10,5"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderBrush" Value="#ddd"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <!-- Триггер для готовых задач (Зеленый фон) -->
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusName}" Value="Готово">
                            <Setter Property="Background" Value="#d5f5e3"/>
                        </DataTrigger>
                        <!-- Триггер для просроченных задач (Красноватый фон) -->
                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                            <Setter Property="Background" Value="#fadbd8"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <!-- Приоритет (Цветной индикатор) -->
                <DataGridTemplateColumn Header="Приоритет" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="15" Height="15" HorizontalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Priority}" Value="3">
                                                <Setter Property="Fill" Value="Red"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Priority}" Value="2">
                                                <Setter Property="Fill" Value="Orange"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Priority}" Value="1">
                                                <Setter Property="Fill" Value="Green"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Задача" Binding="{Binding Title}" Width="2*" FontWeight="Bold"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="2*"/>

                <DataGridTemplateColumn Header="Категория" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="10" Height="10" Margin="0,0,5,0" RadiusX="2" RadiusY="2">
                                    <Rectangle.Fill>
                                        <SolidColorBrush Color="{Binding CategoryColor, TargetNullValue=Gray}"/>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock Text="{Binding CategoryName}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="100"/>
                <DataGridTextColumn Header="Дедлайн" Binding="{Binding Deadline, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>