<Window x:Class="ToDo_with_CSHARP_v2.TaskDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задача" Height="480" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <!-- Название -->
            <TextBlock Text="Название задачи:" FontWeight="Bold"/>
            <TextBox x:Name="txtTitle" Height="30" Padding="5" FontSize="14"/>

            <!-- Описание -->
            <TextBlock Text="Описание:" FontWeight="Bold"/>
            <TextBox x:Name="txtDescription" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="5"/>

            <!-- Приоритет -->
            <TextBlock Text="Приоритет:" FontWeight="Bold"/>
            <ComboBox x:Name="cmbPriority" Height="30"/>

            <!-- Категория -->
            <TextBlock Text="Категория:" FontWeight="Bold"/>
            <ComboBox x:Name="cmbCategory" Height="30"/>

            <!-- Статус -->
            <TextBlock Text="Статус:" FontWeight="Bold"/>
            <ComboBox x:Name="cmbStatus" Height="30"/>

            <!-- Дедлайн -->
            <TextBlock Text="Дедлайн:" FontWeight="Bold"/>
            <DatePicker x:Name="dpDeadline" Height="30" IsEnabled="False"/>
            <CheckBox x:Name="chkNoDeadline" Content="Без дедлайна" IsChecked="True" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Width="90" Height="35" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="Сохранить" Width="90" Height="35" Background="#2ecc71" Foreground="White" FontWeight="Bold" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>